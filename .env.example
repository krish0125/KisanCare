# KisanCare — Environment Variables Template
# ------------------------------------------
# Copy this file to backend/.env and fill in your actual values.
# NEVER commit backend/.env to git — it contains real secrets.
#
# Usage: python-dotenv reads backend/.env automatically when the app starts.
# Every variable has a safe default in config.py so the app runs without crashing
# even when a key is absent — but real keys must be supplied for live features.

# ── MongoDB ────────────────────────────────────────────────────────────────
# Local:  mongodb://localhost:27017/
# Atlas:  mongodb+srv://<user>:<password>@cluster.mongodb.net/
MONGO_URI=mongodb://localhost:27017/

# ── JWT Authentication ──────────────────────────────────────────────────────
# Generate a strong random secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_BEFORE_DEPLOYMENT

# ── Google Gemini AI (for the KisanCare chatbot) ───────────────────────────
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AQ.Ab8RN6L39pTKkyXDCzcqtTfaSpJV7ncCUzc1FNFG7_bN5GvgoA

# ── OpenWeatherMap (Phase 2 — weather backend proxy) ──────────────────────
# Sign up at: https://openweathermap.org/api
# Free tier: 60 calls/minute, 7-day forecast with One Call API
OPENWEATHER_API_KEY=1cb5e89365fec690b30c4037fb3dafe5

# ── data.gov.in — APMC Mandi Prices ───────────────────────────────────────
# Register at: https://data.gov.in/user/r/register
# Resource ID used: 9ef84268-d588-465a-a308-a864a43d0070
DATA_GOV_IN_API_KEY=579b464db66ec23bdd000001cdd3946e44ce4aad7209ff7b23ac571b
